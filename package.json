    "@types/dom-to-image": "^2.6.7",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/pathfinding": "^0.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/webpack-env": "^1.18.8",
    "concurrently": "^10.0.5",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
