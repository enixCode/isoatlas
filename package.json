    "mui-color-input": "^9.0.0",
    "pathfinding": "^0.4.18",
    "quill": "^2.0.3",
    "react-quilljs": "^2.0.5",
    "use-sync-external-store": "^1.6.0",
    "uuid": "^14.0.2",
